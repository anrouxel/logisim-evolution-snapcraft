#!/usr/bin/env bash
set -euo pipefail

# Run the configure hook which sets defaults for any config options
"${SNAP}/meta/hooks/configure"

# Define an array of JVM options
opts=(
    "-Djava.util.prefs.userRoot=${SNAP_USER_DATA}"
)

# The gradle plugin hardlinks every jar produced by the build into
# $SNAP/jar; pick the shadow (fat) jar, whose name embeds the app version.
jar="$(find "${SNAP}/jar" -maxdepth 1 -iname 'logisim-evolution-*-all.jar' -print -quit)"

# Run logisim-evolution with the gathered arguments
exec "${SNAP}/bin/java" "${opts[@]}" -jar "${jar}" "$@"